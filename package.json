{
  "name": "dsh-easy2restart",
  "version": "0.2.1",
  "type": "module",
  "description": "DSH plugin: double-click the sidebar restart button to fully relaunch DeepSeek Harness, plus safe session archiving (confirm dialog + 10s countdown when the session is still busy) and an auto-backup of every archived session. （中文：DSH 重启 + 安全归档插件：双击侧边栏按钮整体重启 DeepSeek Harness；归档会话前先确认、会话仍在活动时倒计时后才能停止归档；任意入口归档成功后自动备份归档会话。）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "restart",
    "relaunch",
    "archive",
    "backup",
    "session"
  ],
  "license": "MIT",
  "icon": "./icon.png",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/plugin.selftest.mjs",
    "prepublishOnly": "node test/plugin.selftest.mjs && node scripts/check-readme-assets.mjs --remote --strict",
    "check:readme": "node scripts/check-readme-assets.mjs",
    "check:readme:remote": "node scripts/check-readme-assets.mjs --remote",
    "check:readme:remote:strict": "node scripts/check-readme-assets.mjs --remote --strict"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMPcosy/dsh-easy2restart.git"
  },
  "homepage": "https://github.com/SMPcosy/dsh-easy2restart#readme",
  "bugs": {
    "url": "https://github.com/SMPcosy/dsh-easy2restart/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "restart",
    "test",
    "README.md",
    "CHANGELOG.md",
    "RENAME.md",
    "LICENSE",
    "icon.png",
    "error-dialog.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
