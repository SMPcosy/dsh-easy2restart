{
  "name": "dsh-plugin-easy2restart",
  "version": "0.1.2",
  "type": "module",
  "description": "DSH plugin: double-click the sidebar restart button to fully relaunch DeepSeek Harness; it is greyed out while an agent session is running. （中文：DSH 重启插件：双击侧边栏重启按钮即可整体重启 DeepSeek Harness，会话运行时按钮置灰禁用。）",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "restart", "relaunch"],
  "license": "MIT",
  "icon": "./icon.png",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/SMPcosy/dsh-plugin-easy2restart.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "restart", "README.md", "LICENSE", "icon.png"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}