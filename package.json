{
  "name": "dsh-plugin-restart",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 重启插件：在侧边栏账号头像上方放一个重启按钮，双击重启 DeepSeek Harness；有 agent 会话运行中时按钮禁用（灰色）。",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "restart", "relaunch"],
  "license": "MIT",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/<owner>/dsh-plugin-restart.git"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "restart", "README.md", "LICENSE"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22"
  }
}